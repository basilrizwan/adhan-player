[Unit]
Description=Adhan Prayer Time Player (local portal + scheduler)
# Do not wait for network-online: first-boot hotspot must start while offline.
After=NetworkManager.service sound.target avahi-daemon.service
Wants=NetworkManager.service avahi-daemon.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/adhan-player
ExecStart=/home/pi/adhan-player/venv/bin/python -m app.main
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=mixed
Environment=PYTHONUNBUFFERED=1

# Allow sleep/wake power management (optional advanced mode)
AmbientCapabilities=CAP_SYS_ADMIN
SupplementaryGroups=audio netdev

[Install]
WantedBy=multi-user.target
